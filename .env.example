# Enter actual values in .env.local or Vercel environment variables.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the PEM header/footer and newlines. Escaped \n is also supported.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
ADMIN_EMAILS=harsimran1869@gmail.com
# Local sample workspace only; automatically disabled in production.
DEMO_MODE=false

# Deadline emails: activate after Google setup; see Step 8 in docs/GOOGLE_SETUP.md.
ZOHO_EMAIL=
ZOHO_PASSWORD=
# Use the same Zoho SMTP host as InternUp. Port 465 uses TLS; 587 requires STARTTLS.
SMTP_HOST=
SMTP_PORT=465
CRON_SECRET=
